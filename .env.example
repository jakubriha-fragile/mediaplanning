# --- Databáze (Vercel Postgres / Neon / vlastní) ---
DATABASE_URL="postgresql://user:heslo@host:5432/mediaplan?sslmode=require"

# --- Auth.js ---
# vygenerujte: openssl rand -base64 32
AUTH_SECRET="zmente-me"
# na Vercelu se doplní automaticky; lokálně nechte takto
NEXTAUTH_URL="http://localhost:3000"

# --- Google SSO (Google Cloud Console → Credentials → OAuth client ID) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Domény, ze kterých se smí kdokoli přihlásit (čárkou oddělené).
# Prázdné = smí se přihlásit jen ten, kdo už je pozvaný v databázi.
ALLOWED_EMAIL_DOMAINS="fragile.cz"

# DOČASNÉ pro testovací fázi: kdokoli z těchto domén dostane roli ADMIN.
# Dokud je vyplněné, svítí v aplikaci upozornění na každé stránce.
# PŘED PUŠTĚNÍM KLIENTA SMAZAT.
ADMIN_EMAIL_DOMAINS=""

# --- Testovací přihlášení bez Googlu ---
# ZAPNĚTE JEN LOKÁLNĚ. V produkci musí být "false" nebo nenastaveno.
ENABLE_DEV_LOGIN="true"
